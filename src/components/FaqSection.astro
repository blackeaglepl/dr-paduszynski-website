---
// Sekcja: Najczęściej zadawane pytania (FAQ) – akordeon oparty na natywnych <details>/<summary>
// Dane pytań i odpowiedzi są zsynchronizowane z src/schemas/faq.ts (FAQPage JSON-LD oraz llms.txt)
import { getLocaleFromUrl, type Locale } from '../utils/i18n';
import { faqItems } from '../schemas/faq';

const currentLocale = getLocaleFromUrl(Astro.url) as Locale;
const items = faqItems[currentLocale];

const translations = {
  pl: {
    heading: { strong: 'Najczęściej zadawane', light: 'pytania' },
    lead: 'Odpowiedzi na najważniejsze pytania dotyczące przebiegu wizyty, przygotowania oraz terapii osteopatycznej w naszym gabinecie w Krakowie.',
    contactPrompt: 'Nie znalazłeś odpowiedzi na swoje pytanie?',
    ctaLabel: 'Skontaktuj się z nami',
    ctaHref: '/kontakt/',
  },
  en: {
    heading: { strong: 'Frequently asked', light: 'questions' },
    lead: 'Answers to the most common questions about your first visit, preparation, and osteopathic therapy at our clinic in Kraków.',
    contactPrompt: 'Still have questions?',
    ctaLabel: 'Contact us',
    ctaHref: '/en/kontakt/',
  },
} as const;

const content = translations[currentLocale];
---

<section class="py-16 md:py-24" aria-labelledby="faq-heading">
  <div class="container mx-auto px-4 md:px-6 max-w-6xl">
    <div class="rounded-[40px] md:rounded-[56px] bg-medical-bg/60 px-5 py-10 md:px-12 md:py-14 lg:px-16">
      <div class="grid md:grid-cols-12 gap-10 md:gap-12 lg:gap-16">
        <!-- Lewa kolumna: nagłówek i CTA kontaktowe (lepki na desktopie) -->
        <div class="md:col-span-4">
          <div class="md:sticky md:top-28" data-animate="fade-up">
            <h2
              id="faq-heading"
              class="font-heading text-medical-text text-h2-mobile md:text-h2-desktop tracking-tight"
            >
              <span class="font-semibold">{content.heading.strong}</span>{' '}
              <span class="font-light">{content.heading.light}</span>
            </h2>
            <p class="mt-4 text-medical-text-light text-body-mobile md:text-body-desktop max-w-md">
              {content.lead}
            </p>
            <p class="mt-6 text-medical-text text-small-mobile md:text-small-desktop font-medium">
              {content.contactPrompt}
            </p>
            <a
              href={content.ctaHref}
              class="mt-3 inline-flex items-center justify-center bg-medical-primary hover:bg-medical-light text-white font-heading font-semibold py-3 px-7 rounded-full text-sm md:text-base transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-medical-primary/50 shadow-sm"
            >
              {content.ctaLabel}
            </a>
          </div>
        </div>

        <!-- Prawa kolumna: akordeon pytań i odpowiedzi -->
        <div class="md:col-span-8 space-y-4">
          {items.map((item, idx) => (
            <details
              class="group rounded-3xl bg-medical-white border border-medical-light/30 px-6 py-5 md:px-8 md:py-6 shadow-sm transition-shadow duration-200 hover:shadow-md"
              open={idx === 0}
              data-animate="fade-up"
              data-animate-delay={80 + idx * 60}
            >
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-heading font-semibold text-medical-text text-base md:text-lg tracking-tight focus:outline-none focus-visible:ring-2 focus-visible:ring-medical-primary/50 rounded-lg">
                <span>{item.question}</span>
                <span
                  class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-medical-bg text-medical-primary transition-transform duration-200 group-open:rotate-180 group-open:bg-medical-primary group-open:text-white"
                  aria-hidden="true"
                >
                  <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                  </svg>
                </span>
              </summary>
              <div class="mt-4 pt-4 border-t border-medical-bg text-medical-text-light text-body-mobile md:text-body-desktop leading-relaxed">
                {item.answer}
              </div>
            </details>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
